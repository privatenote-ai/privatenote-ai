{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "dev:client:http": "VITE_DEV_HTTP=1 vite",
    "dev:workers": "wrangler dev",
    "dev:pages": "npm run build && node scripts/serve-pages.js",
    "build": "vite build",
    "preview": "vite preview",
    "prerender": "tsx scripts/prerender.js",
    "check:locale-home-hrefs": "node scripts/check-locale-home-hrefs.js prerender",
    "build:prerender": "npm run build && tsx scripts/prerender.js && npm run check:locale-home-hrefs && node scripts/verify-prerender-output.js prerender",
    "build:workers": "wrangler deploy --dry-run",
    "build:chrome": "node packages/privatenote-chrome/build.mjs",
    "deploy": "wrangler deploy",
    "check": "tsc",
    "self-host:up": "docker compose --env-file .env.self-host up --build",
    "self-host:down": "docker compose --env-file .env.self-host down",
    "self-host:clean": "docker compose --env-file .env.self-host down -v",
    "test:unit": "tsx --test shared/homeSeoLinks.test.ts shared/supportedLanguages.test.ts shared/localizedBlogSlugs.test.ts shared/publicMarketingPaths.test.ts shared/pageContentSecurityPolicy.test.ts shared/secureFileTransferStructuredData.test.ts shared/blogPostCrossLinks.test.ts shared/passwordGeneratorStructuredData.test.ts client/src/utils/documentMeta.test.ts client/src/utils/isGoogleChrome.test.ts client/src/utils/chromeExtensionOnboarding.test.ts client/src/utils/localizedPath.test.ts client/src/utils/meetingRequestStructuredHint.test.ts client/src/utils/templateStructuredHint.test.ts client/src/components/note/promptTemplates.test.ts client/src/components/note/localFallbackTemplates.test.ts shared/analyticsMetrics.test.ts shared/noteCreationSource.test.ts shared/noteCreationEntryPoint.test.ts shared/kdfParamsV2.test.ts shared/noteExpiry.test.ts shared/noteAad.test.ts shared/noteCryptoWire.test.ts shared/noteId.test.ts shared/urlFragmentKey.test.ts shared/noteMetaEligibility.test.ts shared/storedNotePayload.test.ts src/durable_objects/secure_note_storage.test.ts src/trustedOrigins.test.ts scripts/prerenderIncremental.test.js",
    "db:push": "drizzle-kit push",
    "db:auth:migrate:local": "wrangler d1 migrations apply privatenote-auth-eu --local",
    "db:auth:migrate:remote": "wrangler d1 migrations apply privatenote-auth-eu --remote"
  },
