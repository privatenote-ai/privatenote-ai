{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": "../..",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../../shared/noteCrypto.ts", "../../shared/noteAad.ts", "../../shared/noteExpiry.ts", "../../shared/noteReadLimits.ts", "../../shared/noteSizeLimits.ts", "../../shared/urlFragmentKey.ts"]
}
