/*
  # Cross-Origin Isolation — required for SharedArrayBuffer (used by WebLLM / MLC-AI on-device inference).
  # Without COOP + COEP, window.crossOriginIsolated = false and the WASM threading engine cannot start.
  #
  # COEP: credentialless (preferred over require-corp for Cloudflare Pages)
  #   • Enables cross-origin isolation without requiring every cross-origin sub-resource
  #     to carry CORS or Cross-Origin-Resource-Policy headers.
  #   • Cross-origin requests are made without credentials (cookies/auth), which is fine
  #     for public CDN assets (fonts, model files, Turnstile scripts).
  #   • Supported in Chrome 96+, Firefox 119+, Safari 17.2+.
  #   • Falls back gracefully in older browsers (no isolation, local AI uses its own error path).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/admin/*
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

/magic
  X-Robots-Tag: noindex, nofollow

/account
  X-Robots-Tag: noindex, nofollow

/account/*
  X-Robots-Tag: noindex, nofollow

/note/*
  X-Robots-Tag: noindex, nofollow

/test-llm
  X-Robots-Tag: noindex, nofollow

/llm-ui
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow
