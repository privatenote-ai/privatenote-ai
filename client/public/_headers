/*
  # Cross-Origin Isolation — required for SharedArrayBuffer (used by WebLLM / MLC-AI on-device inference).
  # Without these headers window.crossOriginIsolated = false and the WASM engine will not start
  # in any browser, including Safari on macOS.
  #
  # COEP: require-corp
  #   • Cross-origin subresources embedded in <script>/<link>/<img> etc. need either
  #     a CORS header or Cross-Origin-Resource-Policy: cross-origin.
  #   • fetch() calls with CORS mode (used for model-file downloads) are unaffected.
  #   • Cloudflare Turnstile (challenges.cloudflare.com) ships CORP: cross-origin on its frames.
  #   • HuggingFace CDN model files are fetched via fetch() with CORS, so they are unaffected.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
