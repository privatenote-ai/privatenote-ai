# Copy to `.env.self-host` for local Docker Compose overrides:
#   docker compose --env-file .env.self-host up --build

# Browser-facing ports.
PRIVATENOTE_WEB_PORT=5173
PRIVATENOTE_API_PORT=8787

# The public URL users open in their browser. For the current Compose preview,
# keep this on an allowed local development origin.
PUBLIC_WEB_APP_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787

# Development-only defaults. Replace before any shared or production-like deployment.
AUTH_ALLOW_UNSIGNED_MAGIC_LINK=1
AUTH_SECRET_KEY=dev-only-change-me-32-byte-minimum-secret
TOTP_ENCRYPTION_KEY=dev-only-change-me-32-byte-minimum-key

# Email provider. The current self-host preview should use console/no-op style local flows.
# Production enterprise email requires an implementation decision: SMTP, SES, Graph, or Resend.
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=PrivateNote <no-reply@localhost>

# Turnstile is disabled in the Compose preview. Enterprise deployments can either disable it
# on private networks or provide site/secret keys for internet-exposed environments.
VITE_DISABLE_TURNSTILE=1
VITE_ENABLE_TURNSTILE_IN_DEV=0
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Stripe Payment Links for the Premium page.
# These are public checkout URLs from Stripe, not secret API keys.
VITE_STRIPE_PREMIUM_MONTHLY_PAYMENT_LINK=
VITE_STRIPE_PREMIUM_YEARLY_PAYMENT_LINK=
# Optional public prefilled promotion code. Do not use this for private 100% discounts.
VITE_STRIPE_PREMIUM_PREFILLED_PROMO_CODE=

# Optional early adopter banner controls for the Premium page.
VITE_PREMIUM_EARLY_ADOPTER_PRICING_ENABLED=true
VITE_PREMIUM_EARLY_ADOPTER_USER_LIMIT=200

# Optional local feature switches.
AUTH_DEBUG=0
VITE_LOCAL_LLM_PREMIUM=false
