{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://privatenote.ai",
          "https://www.privatenote.ai",
          "https://premium.privatenote.ai",
          "https://privatenote-ai.pages.dev",
          "https://premium.privatenote-ai.pages.dev",
          "https://develop.privatenote-ai.pages.dev",
          "http://localhost:5000",
          "http://localhost:5173",
          "http://127.0.0.1:5000",
          "http://127.0.0.1:5173",
          "https://localhost:5173",
          "https://localhost:5174",
          "https://127.0.0.1:5173",
          "https://127.0.0.1:5174"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": [
          "content-type",
          "content-md5",
          "x-amz-content-sha256",
          "x-amz-date",
          "authorization"
        ]
      },
      "exposeHeaders": ["ETag", "Content-Length", "x-amz-request-id"],
      "maxAgeSeconds": 86400
    }
  ]
}
